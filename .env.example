# ─── Meridian PMS Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
#
# After setting up .env, run:
#   npx prisma generate          # Generate Prisma client
#   npx prisma db push           # Push schema to database
#
# ═══════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ──────────────────────────────────
# Required. Use your Supabase or Render PostgreSQL connection string.
# Example (Supabase with PgBouncer):
#   DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=7&connect_timeout=15&pool_timeout=15
# Example (Render internal):
#   DATABASE_URL=postgresql://render_user:password@render-db-host:5432/render_db
DATABASE_URL=

# ─── JWT Auth ──────────────────────────────────────────────────
# Strong random string (64+ chars). Used to sign HS256 access tokens.
# Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
