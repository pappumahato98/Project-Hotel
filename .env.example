# ─── Meridian PMS Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
#
# LOCAL DEV:   DATABASE_URL=file:./db/custom.db
# VERCEL:       Fill in ALL Supabase fields + run scripts/setup-vercel-env.sh
# RENDER:       Fill in ALL Supabase fields + set in Render dashboard
#              (or use render.yaml for 1-click deploy)
#
# After setting up .env, run:
#   npx prisma generate          # Generate Prisma client
#   npx prisma db push           # Push schema to Supabase
#
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Supabase Postgres) ─────────────────────────────
# Transaction pooler (port 6543) — for runtime Prisma Client queries
DATABASE_URL=
# Session pooler (port 5432) — for Prisma migrations / db push (DDL needs session mode)
DIRECT_URL=

# ─── Supabase (Auth + Realtime) ───────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only key — bypasses RLS. NEVER expose to the browser.
# Found in: Supabase Dashboard → Settings → API → Project API keys (secret)
SUPABASE_SERVICE_ROLE_KEY=
