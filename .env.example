# ═══════════════════════════════════════════════════════════════════════════════
# LuxeStay ERP - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development
# For Lovable Cloud: These are automatically configured
# For Self-Hosted: Fill in all required values
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 1: DEPLOYMENT MODE
# ─────────────────────────────────────────────────────────────────────────────────
# Set to 'lovable' for Lovable Cloud, 'selfhosted' for docker-compose
VITE_DEPLOYMENT_MODE="lovable"

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 2: SUPABASE / DATABASE
# ─────────────────────────────────────────────────────────────────────────────────
# For Lovable Cloud: Auto-populated
# For Self-Hosted: Point to your Supabase instance or docker-compose services

# Supabase Project URL (API endpoint)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous/Public Key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Project ID (for edge function URLs)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 3: SELF-HOSTED SUPABASE (docker-compose only)
# ─────────────────────────────────────────────────────────────────────────────────
# These are only needed when running docker-compose for self-hosting

# PostgreSQL password (use a strong password in production!)
POSTGRES_PASSWORD="your-super-secret-password"

# JWT Secret for Supabase Auth (min 32 characters)
JWT_SECRET="your-super-secret-jwt-token-with-at-least-32-characters-long"

# JWT token expiry in seconds (3600 = 1 hour)
JWT_EXPIRY="3600"

# Anon key for public API access (generate with supabase CLI or use provided)
ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# Service role key for admin operations (keep secret!)
SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# Secret key base for Realtime service
SECRET_KEY_BASE="UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq"

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 4: APPLICATION URLs
# ─────────────────────────────────────────────────────────────────────────────────
# Frontend URL (where your React app is served)
SITE_URL="http://localhost:5173"

# Backend API URL (Supabase endpoint)
API_EXTERNAL_URL="http://localhost:8000"

# Additional redirect URLs for OAuth (comma-separated)
ADDITIONAL_REDIRECT_URLS=""

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 5: EMAIL / SMTP
# ─────────────────────────────────────────────────────────────────────────────────
# For local dev: Use inbucket (docker-compose includes it)
# For production: Use a real SMTP service

SMTP_HOST="inbucket"
SMTP_PORT="2500"
SMTP_USER=""
SMTP_PASS=""
SMTP_ADMIN_EMAIL="admin@luxestay.local"

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 6: AUTHENTICATION OPTIONS
# ─────────────────────────────────────────────────────────────────────────────────
# Enable/disable signup
DISABLE_SIGNUP="false"

# Auto-confirm emails (set to true for dev, false for production)
ENABLE_EMAIL_AUTOCONFIRM="true"

# Enable anonymous users
ENABLE_ANONYMOUS_USERS="false"

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 7: OAUTH PROVIDERS (Optional)
# ─────────────────────────────────────────────────────────────────────────────────
# Google OAuth
ENABLE_GOOGLE_AUTH="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
ENABLE_GITHUB_AUTH="false"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 8: EXTERNAL INTEGRATIONS (Edge Functions)
# ─────────────────────────────────────────────────────────────────────────────────
# Stripe (for payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Twilio (for SMS/OTP)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Resend (for transactional emails)
RESEND_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 9: FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_SENTRY="false"
VITE_SENTRY_DSN=""

# ─────────────────────────────────────────────────────────────────────────────────
# SECTION 10: DEVELOPMENT
# ─────────────────────────────────────────────────────────────────────────────────
# Enable debug logging
VITE_DEBUG="false"

# Skip auth in development (NOT for production!)
VITE_SKIP_AUTH="false"
