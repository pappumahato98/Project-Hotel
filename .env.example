# ─── Meridian PMS Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
#
# After setting up .env, run:
#   npx prisma generate          # Generate Prisma client
#   npx prisma db push           # Push schema to database
#
# ═══════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Supabase PgBouncer connection URL with query params:
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=7&connect_timeout=15&pool_timeout=15

# ─── JWT Auth ──────────────────────────────────────────────────
# Strong random string (64+ chars). Used to sign HS256 access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
