# ─── Database (Supabase Postgres) ─────────────────────────────
# Connection string from Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Supabase (Auth + Storage + Realtime) ─────────────────────
# All from Supabase Dashboard → Project → Settings → API
# NEXT_PUBLIC_* vars are exposed to the browser (safe to publicize)
NEXT_PUBLIC_SUPABASE_URL=https://[your-project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key — bypasses RLS. NEVER expose to the browser.
# Used for: creating auth users during seeding, admin operations
SUPABASE_SERVICE_ROLE_KEY=
