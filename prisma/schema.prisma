generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── AUTH ──────────────────────────────────────────────────────
// Self-contained JWT auth. Password is bcrypt-hashed.
// Refresh tokens are stored separately in RefreshToken table.
model AuthUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @default("") // bcrypt hash; empty = no password set
  firstName     String
  lastName      String
  role          String   @default("staff") // admin, gm, manager, supervisor, staff
  department    String   @default("Management")
  position      String   @default("Staff")
  avatarUrl     String?
  phone         String?
  dateOfBirth   String?  // ISO date string YYYY-MM-DD
  gender        String?
  address       String?
  city          String?
  country       String?
  nationality   String?
  idType        String?  // passport, national_id, citizenship, license, voter_id
  idNumber      String?
  twoFactorEnabled Boolean @default(false)
  active        Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
}

model RefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique // SHA-256 of the raw refresh token
  userId        String
  tokenFamilyId String    // groups all rotations from one login session
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  replacedBy    String?   // tokenHash of the token that replaced this one
  revokedAt     DateTime? // set when token is revoked due to family compromise

  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenFamilyId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the raw reset token
  userId    String
  ipAddress String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── PROPERTY & CONFIG ────────────────────────────────────────
model Property {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  country     String   @default("Nepal")
  currency    String   @default("NPR")
  timezone    String   @default("Asia/Katmandu")
  phone       String?
  email       String?
  starRating  Int      @default(3)
  totalRooms  Int      @default(0)
  logoUrl     String?
  taxRate     Float    @default(13.0)
  serviceCharge Float  @default(10.0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
  ratePlans   RatePlan[]
  reservations Reservation[]
  employees   Employee[]
}

// ─── ROOM MANAGEMENT ──────────────────────────────────────────
model RoomType {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  baseOccupancy Int
  maxOccupancy  Int
  bedConfig   String   @default("1 King Bed")
  areaSqFt    Float?
  view        String?
  amenities   String?  // JSON array of amenities
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
  ratePlans   RatePlan[]
  restrictions RoomRestriction[]
}

model Room {
  id          String   @id @default(cuid())
  number      String
  floor       Int
  wing        String?
  building    String?
  typeId      String
  propertyId  String
  status      String   @default("vacant_clean") // vacant_clean, vacant_dirty, occupied, cleaning, inspected, out_of_order, out_of_inventory, on_change
  view        String?
  accessibility Boolean @default(false)
  connectingRoomId String?
  ipPhoneExt  String?
  tvChannel   String?
  notes       String?

  type        RoomType @relation(fields: [typeId], references: [id])
  property    Property @relation(fields: [propertyId], references: [id])
  reservations Reservation[]
  hkTasks     HkTask[]
  workOrders  WorkOrder[]
  hkWorkFlows HkWorkFlow[]

  @@unique([number, propertyId])
  @@index([status])
  @@index([propertyId])
}

model RoomRestriction {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime
  restrictionType String // stop_sell, cta, ctd, min_los, max_los
  value       Int?
  reason      String?
  createdAt   DateTime @default(now())

  roomType    RoomType @relation(fields: [roomTypeId], references: [id])
}

// ─── RATE MANAGEMENT ──────────────────────────────────────────
model RatePlan {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  propertyId  String
  roomTypeId  String?
  baseRate    Float
  taxInclusive Boolean @default(false)
  active      Boolean @default(true)
  channel     String?  // direct, ota, corporate, group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id])
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id])
  rates       DailyRate[]
}

model DailyRate {
  id          String   @id @default(cuid())
  ratePlanId  String
  date        DateTime
  rate        Float
  available   Int      @default(0)

  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([ratePlanId, date])
}

// ─── GUEST / CRM ──────────────────────────────────────────────
model Guest {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  nationality   String?
  idType        String?  // passport, national_id, drivers_license
  idNumber      String?
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  city          String?
  country       String?
  vipLevel      String   @default("none") // none, silver, gold, platinum
  loyaltyPoints Int      @default(0)
  loyaltyTier   String   @default("none")
  preferences   String?  // JSON preferences
  notes         String?
  totalStays    Int      @default(0)
  totalRevenue  Float    @default(0)
  lastStayAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations Reservation[]
  folios        Folio[]

  @@index([firstName])
  @@index([lastName])
}

// ─── RESERVATIONS ──────────────────────────────────────────────
model Reservation {
  id              String   @id @default(cuid())
  confirmationNo  String @unique
  reservationNumber String? // Fiscal-year sequential: "Res-82/83-001"
  propertyId      String
  guestId       String?
  roomId        String?
  roomTypeId    String?
  ratePlanId    String?
  status        String   @default("confirmed") // tentative, confirmed, checked_in, checked_out, cancelled, no_show, waitlist
  reservationType String @default("individual") // individual, group, corporate, day_use, walk_in
  adults        Int      @default(1)
  children      Int      @default(0)
  checkIn       DateTime
  checkOut      DateTime
  roomRate      Float
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  creditLimit   Float    @default(15000)
  specialRequests String?
  source        String?  // direct, booking_com, expedia, walk_in, phone, email, corporate
  paymentStatus String   @default("unpaid")
  guaranteed    Boolean  @default(false)
  company       String?
  poNumber      String?
  notes         String?
  bookedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property      Property @relation(fields: [propertyId], references: [id])
  guest         Guest?   @relation(fields: [guestId], references: [id])
  room          Room?    @relation(fields: [roomId], references: [id])
  folios        Folio[]
  bookingContact BookingContact?
  ratePostings  RoomRatePosting[]
  guestDocuments GuestDocument[]

  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([roomId])
  @@index([guestId])
  @@index([propertyId])
  @@index([status, checkIn])
  @@index([status, checkOut])
}

// ─── GUEST FOLIO ─────────────────────────────────────────────
model Folio {
  id            String   @id @default(cuid())
  reservationId String
  guestId       String
  folioType     String   @default("guest") // guest, company, comp, master
  status        String   @default("open") // open, closed, locked
  balance       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guest         Guest     @relation(fields: [guestId], references: [id])
  transactions  FolioTransaction[]
  payments      FolioPayment[]
  ratePostings  RoomRatePosting[]

  @@index([reservationId])
  @@index([guestId])
  @@index([status])
}

model FolioTransaction {
  id            String   @id @default(cuid())
  folioId       String
  transactionType String // room, f_and_b, laundry, spa, phone, minibar, business_center, miscellaneous
  description   String
  amount        Float
  taxAmount     Float    @default(0)
  totalAmount   Float
  quantity      Int      @default(1)
  reference     String?  // outlet/order reference
  outlet        String?
  postedBy      String?
  createdAt     DateTime @default(now())

  folio         Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([createdAt])
  @@index([transactionType])
}

model FolioPayment {
  id            String   @id @default(cuid())
  folioId       String
  paymentMethod String // cash, card, bank_transfer, cheque, city_ledger, voucher, gift_card, foreign_currency
  amount        Float
  reference     String?
  cardType      String?  // visa, mastercard, amex
  exchangeRate  Float?
  foreignAmount Float?
  receivedBy    String?
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  folio         Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([createdAt])
  @@index([status])
}

// ─── POS / OUTLETS ────────────────────────────────────────────
model Outlet {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  type          String   // restaurant, bar, spa, laundry, business_center, gift_shop
  description   String?
  location      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  menuItems     MenuItem[]
  orders        PosOrder[]
}

model MenuItem {
  id            String   @id @default(cuid())
  outletId      String
  name          String
  category      String
  price         Float
  taxRate       Float    @default(0.13)
  available     Boolean  @default(true)
  allergens     String?  // JSON array
  sortOrder     Int      @default(0)

  outlet        Outlet @relation(fields: [outletId], references: [id])
  orderItems    OrderItem[]
}

model PosOrder {
  id            String   @id @default(cuid())
  outletId      String
  tableNumber   Int?
  reservationId String?
  folioId       String?
  status        String   @default("open") // open, in_progress, ready, served, closed, voided
  serverName    String?
  guestCount    Int      @default(1)
  totalAmount   Float    @default(0)
  taxAmount     Float    @default(0)
  discountAmount Float   @default(0)
  paymentStatus String   @default("unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet        Outlet @relation(fields: [outletId], references: [id])
  items         OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([outletId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  quantity      Int      @default(1)
  unitPrice     Float
  totalPrice    Float
  status        String   @default("pending") // pending, preparing, ready, served, voided
  notes         String?
  createdAt     DateTime @default(now())

  order         PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── HOUSEKEEPING ─────────────────────────────────────────────
model HkTask {
  id            String   @id @default(cuid())
  roomId        String
  taskType      String   // checkout, stayover, turndown, deep_clean, maintenance
  status        String   @default("pending") // pending, assigned, in_progress, cleaned, inspected, failed
  priority      String   @default("normal") // low, normal, high, rush, vip
  assignedTo    String?
  inspectedBy   String?
  scheduledTime DateTime
  completedTime DateTime?
  estimatedMinutes Int   @default(30)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room          Room     @relation(fields: [roomId], references: [id])

  @@index([status])
  @@index([roomId])
}

model HkInspectionAudit {
  id            String   @id @default(cuid())
  hkTaskId      String
  roomId        String
  roomNumber    String
  action        String   // reject_reassign, approve, force_mutation
  performedBy   String   // user name who did the action
  reason        String?  // why notes (required for reject)
  checklistJson String?  // JSON snapshot of inspection checklist
  photosJson    String?  // JSON array of captured photo base64 or URLs
  createdAt     DateTime @default(now())
}

model LostFound {
  id            String   @id @default(cuid())
  roomId        String?
  itemName      String
  category      String // electronics, clothing, jewelry, documents, keys, bags, books, other
  description   String?
  storageLocation String?
  foundBy       String
  foundDate     DateTime @default(now())
  claimedBy     String?
  claimDate     DateTime?
  status        String   @default("found") // found, claimed, donated, disposed
  identityVerified Boolean @default(false)
  claimAttachment  String?  // base64 or filename of claimant ID photo
  createdAt     DateTime @default(now())
}

// ─── HOUSEKEEPING WORKFLOW ───────────────────────────────────
model HkWorkFlow {
  id              String   @id @default(cuid())
  title           String
  description     String?
  priority        String   @default("low")       // low, medium, high, na
  category        String   @default("maintenance") // maintenance, repair, service, inspection, safety
  area            String?                          // area or room reference
  roomId          String?
  status          String   @default("open")      // open, in_progress, completed
  assignedTo      String?
  assignedByName  String?
  requestedDate   DateTime @default(now())
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room            Room?    @relation(fields: [roomId], references: [id])

  @@index([status])
  @@index([priority])
}

// ─── EVENTS & BANQUET ────────────────────────────────────────
model Event {
  id            String   @id @default(cuid())
  name          String
  organizerName String
  organizerPhone String?
  organizerEmail String?
  eventType     String   // corporate, wedding, birthday, conference, meeting
  venue         String?
  startDate     DateTime
  endDate       DateTime
  expectedPax   Int
  status        String   @default("confirmed") // tentative, confirmed, in_progress, completed, cancelled
  totalRevenue  Float    @default(0)
  depositAmount Float    @default(0)
  depositPaid  Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── HR & EMPLOYEES ───────────────────────────────────────────
model Employee {
  id            String   @id @default(cuid())
  propertyId    String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  department    String
  position      String
  role          String   @default("staff") // staff, supervisor, manager, admin, gm
  hireDate      DateTime?
  salary        Float?
  status        String   @default("active") // active, on_leave, resigned, terminated
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property      Property @relation(fields: [propertyId], references: [id])

  @@index([department])
  @@index([email])
}

// ─── OPERATIONS ────────────────────────────────────────────────
model NightAudit {
  id            String   @id @default(cuid())
  businessDate  DateTime
  status        String   @default("pending") // pending, in_progress, completed
  startedBy     String?
  completedBy   String?
  startedAt     DateTime?
  completedAt   DateTime?
  roomRevenue   Float    @default(0)
  fAndBRevenue  Float    @default(0)
  otherRevenue  Float    @default(0)
  totalRevenue  Float    @default(0)
  totalTax      Float    @default(0)
  occupancy     Float    @default(0)
  adr           Float    @default(0)
  revpar        Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([status, businessDate])
}

model CashierShift {
  id            String   @id @default(cuid())
  cashierName   String
  shiftType     String   // morning, evening, night
  startDate     DateTime
  endDate       DateTime?
  openingFloat  Float    @default(0)
  closingFloat  Float?
  totalPayments Float    @default(0)
  totalRefunds  Float    @default(0)
  variance      Float?
  status        String   @default("open") // open, closed
  createdAt     DateTime @default(now())
}

// ─── INVENTORY ────────────────────────────────────────────────
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  unit          String   // piece, kg, liter, pack
  currentStock  Float    @default(0)
  reorderPoint  Float    @default(0)
  unitCost      Float
  supplier      String?
  location      String?
  minStock      Float    @default(0)
  maxStock      Float    @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── MAINTENANCE ───────────────────────────────────────────────
model WorkOrder {
  id            String   @id @default(cuid())
  roomId        String?
  room          Room?       @relation(fields: [roomId], references: [id])
  title         String
  description   String
  priority      String   @default("normal") // low, normal, high, emergency
  status        String   @default("open") // open, assigned, in_progress, completed, closed
  category      String   // electrical, plumbing, hvac, furniture, painting, general
  assignedTo    String?
  reportedBy    String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([roomId])
  @@index([createdAt])
}

// ─── ACCOUNTING ───────────────────────────────────────────────
model LedgerAccount {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String   // asset, liability, equity, revenue, expense
  subtype       String?  // current, non_current, bank, cash, receivable, payable, equity_account, revenue_account, expense_account
  description   String?
  department    String?  // cost center / department for departmental accounting
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  journalLines JournalEntryLine[]
}

model JournalEntry {
  id            String   @id @default(cuid())
  date          DateTime
  description   String
  reference     String?
  status        String   @default("draft") // draft, posted, voided
  sourceModule  String?  // front_desk, pos, payroll, inventory, events, manual, night_audit, accounts_payable, accounts_receivable
  sourceId      String?  // foreign key to source record (e.g. FolioTransaction.id, PosOrder.id)
  createdBy     String?
  postedBy      String?
  postedAt      DateTime?
  createdAt     DateTime @default(now())

  lines         JournalEntryLine[]
}

model JournalEntryLine {
  id            String   @id @default(cuid())
  entryId       String
  accountId     String
  debit         Float    @default(0)
  credit        Float    @default(0)
  narration     String?

  entry         JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       LedgerAccount @relation(fields: [accountId], references: [id])
}

// ─── ACCOUNTING PERIODS (Month-end / Year-end close) ─────
model AccountingPeriod {
  id            String   @id @default(cuid())
  period        String   @unique  // e.g. "2025-07", "2025-Q3", "2025"
  periodType    String              // month, quarter, year
  startDate     DateTime
  endDate       DateTime
  status        String   @default("open") // open, closing, closed
  closedBy      String?
  closedAt      DateTime?
  openingTrialBalance String?  // JSON snapshot of trial balance at close
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// ─── RECONCILIATION ─────────────────────────────────────
model Reconciliation {
  id            String   @id @default(cuid())
  accountId     String
  accountName   String?
  accountCode   String?
  bankName      String?
  statementDate DateTime?
  statementBalance Float
  bookBalance   Float
  difference    Float
  status        String   @default("pending") // pending, reconciled, discrepancy
  reconciledBy  String?
  reconciledAt  DateTime?
  adjustments   String?  // JSON array of reconciliation adjustments
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
  @@index([status])
}

// ─── ATTENDANCE ───────────────────────────────────────────────
model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employeeName  String
  department    String
  position      String
  checkIn       String?
  checkOut      String?
  date          DateTime @default(now())
  status        String   @default("present") // present, absent, on_leave, half_day
  late          Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── PAYROLL ──────────────────────────────────────────────────
model Payroll {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  department      String
  position        String
  month           String   // e.g., "2025-07"
  baseSalary      Float
  variablePay     Float    @default(0)
  overtime        Float    @default(0)
  deductions      Float    @default(0)
  netPay          Float
  status          String   @default("pending") // pending, processed, paid
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── VENDORS ──────────────────────────────────────────────────
model Vendor {
  id            String   @id @default(cuid())
  name          String
  contact       String?
  phone         String?
  email         String?
  category      String
  rating        Float    @default(0)
  status        String   @default("active") // active, inactive
  lastOrderDate DateTime?
  totalOrders   Int      @default(0)
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── PURCHASE ORDERS ────────────────────────────────────────
model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique
  vendor          String
  vendorId        String
  date            DateTime  @default(now())
  expectedDelivery String?
  items           String    // JSON array of { name, quantity, unitPrice, unit }
  totalAmount     Float     @default(0)
  priority        String    @default("normal") // high, normal, low
  status          String    @default("draft")   // draft, pending, approved, ordered, partial, delivered, cancelled
  notes           String?
  terms           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([poNumber])
}

// ─── REQUISITIONS ─────────────────────────────────────────────
model Requisition {
  id            String   @id @default(cuid())
  requestDate   DateTime @default(now())
  department    String
  requestor     String
  items         String   // JSON array of items
  status        String   @default("pending") // pending, approved, rejected, received, ordered
  priority      String   @default("normal") // low, normal, high, urgent
  totalItems    Int      @default(0)
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── ASSETS ────────────────────────────────────────────────────
model Asset {
  id              String   @id @default(cuid())
  name            String
  category        String
  location        String
  purchaseDate    DateTime?
  purchaseCost    Float
  currentValue   Float
  status          String   @default("operational") // operational, needs_repair, decommissioned, disposed
  warrantyExpiry  DateTime?
  lastMaintenance DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── HELP & SUPPORT ──────────────────────────────────────────
model SupportTicket {
  id            String   @id @default(cuid())
  ticketNo      String   @unique
  subject       String
  description   String
  category      String   @default("general") // general, bug, feature_request, billing, technical, training, other
  priority      String   @default("normal") // low, normal, high, urgent
  status        String   @default("open") // open, in_progress, resolved, closed, reopened
  createdBy     String
  createdByName String
  department    String
  assignedTo    String?
  assignedName  String?
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── ROOM MOVES (Drag & Drop Tracking) ────────────────────
model RoomMoveLog {
  id              String   @id @default(cuid())
  reservationId   String
  confirmationNo  String?
  fromRoomId      String?
  fromRoomNumber  String?
  toRoomId        String?
  toRoomNumber    String?
  fromCheckIn     DateTime?
  toCheckIn       DateTime?
  fromCheckOut    DateTime?
  toCheckOut      DateTime?
  moveType        String   // room_change, date_change, both
  reason          String
  changedBy       String?
  changedByName   String?
  createdAt       DateTime @default(now())
}

// ─── CHANNELS ─────────────────────────────────────────────────
model Channel {
  id                String   @id @default(cuid())
  name              String
  type              String   // OTA, Direct, Corporate, Wholesale
  logo              String?
  status            String   @default("connected") // connected, disconnected, active
  lastSync          DateTime?
  totalBookings     Int      @default(0)
  monthlyCommission Float    @default(0)
  mappingStatus     String   @default("complete") // complete, incomplete, n/a
  commissionRate    Float    @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── BOOKING CONTACT (Person/Company who made the reservation) ──
model BookingContact {
  id            String   @id @default(cuid())
  reservationId String   @unique
  contactType   String   @default("person") // person, company, travel_agent, online_travel_agent
  salutation    String?  // Mr, Ms, Mrs, Dr, etc.
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  mobile        String?
  companyName   String?
  companyAddress String?
  city          String?
  country       String?
  taxId         String?  // VAT/PAN number for companies
  website       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ─── GUEST DOCUMENTS (ID verification for check-in) ───────────
model GuestDocument {
  id            String   @id @default(cuid())
  reservationId String
  guestId       String?
  docType       String   // passport, national_id, drivers_license, visa, birth_certificate
  docNumber     String?
  docExpiry     DateTime?
  issueCountry  String?
  issueDate     DateTime?
  placeOfIssue  String?
  filePath      String?  // future file storage reference
  fileName      String?
  fileSize      Int?     // bytes
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ─── ROOM RATE POSTING (Daily room charge to guest ledger) ────
model RoomRatePosting {
  id            String   @id @default(cuid())
  reservationId String
  folioId       String
  roomId        String
  postingDate   DateTime  // the date the charge is for (the stay night)
  roomRate      Float     // base room rate for that night
  taxAmount     Float     @default(0)
  serviceCharge Float     @default(0)
  totalAmount   Float     // roomRate + taxAmount + serviceCharge
  status        String    @default("posted") // posted, voided, adjusted
  postedBy      String?
  voidedBy      String?
  voidReason    String?
  createdAt     DateTime  @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folio         Folio      @relation(fields: [folioId], references: [id], onDelete: Cascade)
}

// ─── ACTIVITY LOG ─────────────────────────────────────────
model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  action        String   // login, logout, profile_update, password_change, settings_update, reservation_create, check_in, check_out, etc.
  module        String   // Auth, Front Desk, Settings, Accounting, POS, Housekeeping, etc.
  details       String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // auth_success, auth_failure, rate_limit, suspicious_request, privilege_escalation, session_invalidated
  level     String   @default("info") // info, warning, critical
  userId    String?
  email     String?
  ipAddress String?
  userAgent String?
  path      String?
  method    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@index([level])
}

// ─── WAITLIST ────────────────────────────────────────
model WaitlistEntry {
  id             String   @id @default(cuid())
  guestName      String
  contactPhone   String?
  contactEmail   String?
  roomPreference String?
  roomTypeId     String?
  checkInDate    String   // YYYY-MM-DD
  checkOutDate   String   // YYYY-MM-DD
  adults         Int      @default(2)
  children       Int      @default(0)
  priority       String   @default("Normal") // High, Normal, Low
  status         String   @default("Waiting") // Waiting, Assigned, Cancelled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status])
  @@index([priority])
  @@index([checkInDate])
}

// ─── WAKE-UP CALLS ──────────────────────────────────
model WakeUpCall {
  id             String   @id @default(cuid())
  reservationId  String?
  roomId         String?
  roomNumber     String
  guestName      String
  scheduledTime  String   // HH:mm format
  status         String   @default("Pending") // Pending, Called, Snoozed, Missed, Completed
  phoneExtension String?
  notes          String?
  snoozeCount    Int      @default(0)
  calledAt       DateTime?
  completedAt    DateTime?
  date           String   // YYYY-MM-DD — which day this call is for
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([date])
  @@index([status])
  @@index([scheduledTime])
}

// ─── LEAVE MANAGEMENT ──────────────────────────────────────
model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  employeeName  String
  department    String
  leaveType     String   // annual, sick, maternity, paternity, casual, unpaid, comp_off
  startDate     DateTime
  endDate       DateTime
  duration      Float    // total days (supports half-day)
  status        String   @default("Pending") // Pending, Approved, Rejected, Cancelled
  reason        String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([department])
  @@index([startDate])
}

// ─── PERFORMANCE REVIEWS ──────────────────────────────────
model PerformanceReview {
  id              String   @id @default(cuid())
  employeeId      String
  employeeName    String
  department      String
  position        String
  reviewPeriod    String   // e.g. "2025-Q1", "2025-H1", "2025"
  reviewDate      DateTime @default(now())
  reviewerName    String
  reviewerId      String?
  attendanceScore Float    @default(0)
  taskScore       Float    @default(0)
  guestSatScore   Float    @default(0)
  punctualityScore Float   @default(0)
  overallScore    Float    @default(0)
  strengths       String?
  improvements    String?
  goals           String?
  status          String   @default("Draft") // Draft, Submitted, Approved
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([department])
  @@index([reviewPeriod])
  @@index([status])
}

// ─── TRAINING ────────────────────────────────────────────
model TrainingSession {
  id          String   @id @default(cuid())
  courseName  String
  instructor  String
  date        DateTime
  endDate     DateTime?
  duration    String
  enrolled    Int      @default(0)
  maxCapacity Int
  status      String   @default("Upcoming") // Upcoming, In Progress, Completed, Cancelled
  category    String
  description String?
  location    String?
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([date])
}

model TrainingEnrollment {
  id            String   @id @default(cuid())
  sessionId     String
  employeeId    String
  employeeName  String
  department    String
  status        String   @default("Enrolled") // Enrolled, Completed, Absent, Cancelled
  score         Float?
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([employeeId])
}

// ─── SHIFT EXCHANGE ──────────────────────────────────────
model ShiftExchange {
  id              String   @id @default(cuid())
  requesterId     String
  requesterName   String
  requesterDept   String
  fromShift       String   // e.g. "Morning (07:00-15:00)"
  toShift         String   // e.g. "Evening (15:00-23:00)"
  targetId        String?
  targetName      String?
  exchangeDate    DateTime
  reason          String
  status          String   @default("Pending") // Pending, Approved, Rejected, Cancelled
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([requesterDept])
  @@index([exchangeDate])
}

// ─── RECRUITMENT ────────────────────────────────────────
model JobPosting {
  id              String   @id @default(cuid())
  position        String
  department      String
  employmentType  String   @default("Full-time") // Full-time, Part-time, Contract
  description     String?
  requirements    String?
  salaryMin       Float?
  salaryMax       Float?
  status          String   @default("Draft") // Draft, Open, Closed, Filled
  postedBy        String?
  postedAt        DateTime?
  deadline        DateTime?
  appliedCount    Int      @default(0)
  screeningCount  Int      @default(0)
  interviewCount  Int      @default(0)
  offerCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([department])
}

model JobApplication {
  id              String   @id @default(cuid())
  postingId       String
  applicantName   String
  applicantEmail  String?
  applicantPhone  String?
  status          String   @default("Applied") // Applied, Screening, Interview, Offer, Rejected, Hired
  appliedAt       DateTime @default(now())
  notes           String?
  resumeUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([postingId])
  @@index([status])
}

// ─── BUDGETS ────────────────────────────────────────────
model Budget {
  id              String   @id @default(cuid())
  name            String
  fiscalYear      String   // e.g. "2025"
  period          String   // e.g. "2025-01", "2025-Q1", "2025-H1"
  accountId       String?
  accountName     String?
  accountCode     String?
  department      String?
  budgetedAmount  Float
  actualAmount    Float    @default(0)
  status          String   @default("Active") // Active, Closed, Archived
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fiscalYear])
  @@index([department])
  @@index([status])
}

// ─── INVOICES ───────────────────────────────────────────
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  type            String   @default("sales") // sales, purchase, credit_note, debit_note
  vendorName      String?
  customerName    String?
  date            DateTime @default(now())
  dueDate         DateTime?
  status          String   @default("Draft") // Draft, Sent, Paid, Partially Paid, Overdue, Cancelled
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems       InvoiceLineItem[]

  @@index([status])
  @@index([type])
  @@index([date])
}

model InvoiceLineItem {
  id            String   @id @default(cuid())
  invoiceId     String
  description   String
  quantity      Float    @default(1)
  unitPrice     Float
  taxRate       Float    @default(13)
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── SYSTEM SETTINGS ────────────────────────────────────────
model SystemSetting {
  id          String   @id @default(cuid())
  category    String   // general, display, tax, policies, payment, room_defaults, email, printing, notifications, integrations, security, backup
  key         String   @unique
  value       String   // JSON-encoded value for complex types, plain string for simple ones
  type        String   @default("string") // string, number, boolean, json
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
